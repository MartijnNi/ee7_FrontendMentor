mixin junior_opdracht_2()
  //mobile version time 1.30.00 + setup & scss.
  .junior_opdracht_2
    .card.mx-auto.my-auto
      .card__image
        img(src="/images/NFT-Previeuw-Card/image-equilibrium.jpg", alt="Coin", srcset="")
      .card__title
        h1 Equilibrium #3429
        p Our Equilibrium collection promotes balance and calm.
      .card__stats 
        .card__stat
          img(src="/images/NFT-Previeuw-Card/icon-ethereum.svg", alt="Ethereum icon")
          p 0.041 ETH
        .card__stat
          img(src="/images/NFT-Previeuw-Card/icon-clock.svg", alt="clock icon")
          p 3 days left
      .card__profile
        img(src="/images/NFT-Previeuw-Card/image-avatar.png", alt="image", srcset="")
        p Creation of #[span.highlight Jules Wyvern]


      


