mixin junior_opdracht_4()
  .junior_opdracht_4
    div(class="product max-w-[475px] lg:max-w-[1024px] mx-auto my-auto")
      .product__image
        picture.product__picture
          source(srcset="/images/Product_card/image-product-desktop.jpg", media="(min-width: 1024px)" alt="product image")
          img(src="/images/Product_card/image-product-mobile.jpg" ,alt="product image", srcset="")
      .product__body
        .product__item 
          p Perfume 
        .product__title
          h1 Gabrielle Essence Eau De Parfum
        .product__description 
          p A floral, solar and voluptuous interpretation composed by Olivier Polge, Perfumer-Creator for the House of CHANEL.
        .product__price
          p $149.99
          p $99.99
        button.product__button(type="button")
          img(src="/images/Product_card/icon-cart.svg", alt="Cart")
          span Add to cart

