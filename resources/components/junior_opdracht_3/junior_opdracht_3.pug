mixin junior_opdracht_3()
  .junior_opdracht_3
    div(class="max-w-[475px] lg:max-w-[1024px] mx-auto my-auto")
      .newsletter
        picture.newsletter__image
          source(srcset="/images/newsletter/illustration-sign-up-desktop.svg", media="(min-width: 1024px)")
          img(src="/images/newsletter/illustration-sign-up-mobile.svg", alt="clock icon")
        .newsletter__content
          h1 Stay Updated! 
          p Join 60,000+ product managers receiving monthly updates on: 
          .newsletter__list 
            ul  
              li 
                p Product discovery and building what matters
              li  
                p measuring to ensure updates are a succes 
              li 
                p And much more! 
          form#newsletterForm.newsletter__form
            .newsletter__input
              .newsletter__input-label
                label(for="email") Email address
                span.newsletter_alert Invalid email address
              input(type="email", name="email", id="email", placeholder="email@company.com", required)
            button(type="submit") Subscribe to monthly newsletter




