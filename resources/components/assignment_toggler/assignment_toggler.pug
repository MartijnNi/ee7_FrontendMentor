mixin assignment_toggler()
  .assignment_toggler-overlay(x-show="showAssignment !== 0" @click="showAssignment = 0")
    .assignment_toggler-content(@click.stop)
      button.close-button(@click="showAssignment = 0") Close
      div(x-data="{showAssignment: 0}")
        button(@click="showAssignment = 1") Junior Opdracht 1
        button(@click="showAssignment = 2") Junior Opdracht 2
        div(x-show="showAssignment === 1") 
          +junior_opdracht_1()
        div(x-show="showAssignment === 2")
          +junior_opdracht_2()